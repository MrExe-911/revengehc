# Salin file ini jadi ".env" untuk development lokal (JANGAN commit file .env asli ke git).
# Untuk production, isi variabel ini di dashboard hosting kamu (Vercel/Netlify/dst),
# BUKAN di file ini atau di kode frontend manapun.

# API key dari akun Minecraft-MP kamu (Server Panel → API). Dipakai HANYA oleh
# api/top-voters.js di server, tidak pernah dikirim ke browser.
MINECRAFT_MP_API_KEY=

# Kredensial panel Pterodactyl (Client API), dipakai HANYA oleh api/teams.js di
# server untuk membaca data tim plugin BetterTeams. Tidak pernah dikirim ke browser.
# - PTERODACTYL_PANEL_URL: alamat panel kamu, TANPA garis miring di akhir.
#     Contoh: https://panel.domainmu.id
# - PTERODACTYL_SERVER_ID: ID pendek server (lihat di URL panel saat buka server).
# - PTERODACTYL_API_KEY: dari Account -> API Credentials di panel (bukan API Key
#     Application, tapi Client API Key milikmu sendiri).
PTERODACTYL_PANEL_URL=
PTERODACTYL_SERVER_ID=
PTERODACTYL_API_KEY=
# Opsional — isi kalau path folder teamInfo plugin BetterTeams kamu berbeda.
BETTERTEAMS_PATH=/plugins/BetterTeams/teamInfo
